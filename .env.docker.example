# Local gateway authentication. "local" is the Compose default.
GATEWAY_API_KEY=local

# OpenWebUI is optional and is not deployed by default. Uncomment this to
# always include it, or ask for it per command with `make up-webui` or
# `docker compose --profile webui up`.
# COMPOSE_PROFILES=webui

# OpenWebUI is published on localhost only. Leave the secret empty for a
# generated local secret, or set a stable random value before first startup.
OPEN_WEBUI_PORT=3001
OPEN_WEBUI_SECRET_KEY=
OPEN_WEBUI_VERSION=v0.11.0-slim

# On Linux, set this to the output of: id -u
# The Makefile targets export this value automatically and ignore the setting
# below; it only applies to direct `docker compose` invocations.
GATEWAY_UID=1000

# Gateway config.yaml, mounted read-only. Defaults to ./config.example.yaml.
# The Makefile targets point this at ./config.yaml automatically once it exists.
# GATEWAY_CONFIG_FILE=./config.yaml

# Optional host paths. These defaults are used when omitted:
# HOST_CODEX_HOME=/home/you/.codex
# HOST_CLAUDE_HOME=/home/you/.claude
# HOST_CLAUDE_CONFIG=/home/you/.claude.json
# GATEWAY_WORKSPACE=/home/you/workspace

# Rebuild with other tested official client releases when desired.
CODEX_VERSION=0.149.0
CLAUDE_CODE_VERSION=2.1.226
